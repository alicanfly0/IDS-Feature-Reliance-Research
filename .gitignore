# Datasets: never commit raw or processed data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.parquet
*.pcap
*.pcapng
*.zip
*.tar.gz
*.7z

# Model artifacts and large experiment outputs
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.npy
*.npz
results/runs/
results/cache/
results/splits/
results/benchmarks/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
.env

# Notebooks / editors / OS
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# LaTeX build files
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.bbl
paper/**/*.blg
paper/**/*.synctex.gz
paper/**/*.fdb_latexmk
paper/**/*.fls
